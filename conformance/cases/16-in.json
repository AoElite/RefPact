{
  "description": "`must_be_in`: each selected unit is in one of the places.",
  "separator": "::",
  "facts": {
    "units": ["crate", "crate::api", "crate::api::http", "crate::domain", "crate::util", "crate::orphan"],
    "kinds": ["use"],
    "facts": [
      {"unit": "crate", "file": "src/lib.rs", "line": 1, "reference": {"target": "crate::api::http::serve", "kind": "use"}},
      {"unit": "crate::api::http", "file": "src/api/http.rs", "line": 1, "reference": {"target": "crate::domain::Order", "kind": "use"}},
      {"unit": "crate::util", "file": "src/util.rs", "line": 1, "reference": {"target": "crate::domain::Order", "kind": "use"}}
    ]
  },
  "cases": [
    {"name": "a unit in no place is reported", "rule": {"name": "r", "subjects": {"all": true}, "must_be_in": {"places": ["crate::api::**", "crate::domain::**"]}}, "expect": {"violations": [{"unit": "crate", "file": "src/lib.rs", "line": 0, "column": 0, "detail": "outside"}, {"unit": "crate::util", "file": "src/util.rs", "line": 0, "column": 0, "detail": "outside"}, {"unit": "crate::orphan", "file": "", "line": 0, "column": 0, "detail": "outside"}]}},
    {"name": "only the selected units must be in a place", "rule": {"name": "r", "subjects": {"all": true, "except": ["crate", "crate::orphan"]}, "must_be_in": {"places": ["crate::api::**", "crate::domain::**"]}}, "expect": {"violations": [{"unit": "crate::util", "detail": "outside"}]}},
    {"name": "places match exactly", "rule": {"name": "r", "subjects": {"any_of": ["crate::api::**"]}, "must_be_in": {"places": ["crate::api"]}}, "expect": {"violations": [{"unit": "crate::api::http", "detail": "outside"}]}},
    {"name": "units that are all in places pass", "rule": {"name": "r", "subjects": {"all": true}, "must_be_in": {"places": ["crate", "crate::api::**", "crate::domain", "crate::util", "crate::orphan"]}}, "expect": {"violations": []}},
    {"name": "a baseline accepts a unit outside the places", "rule": {"name": "r", "subjects": {"all": true, "except": ["crate", "crate::orphan"]}, "must_be_in": {"places": ["crate::api::**", "crate::domain::**"]}}, "baseline": "r\tcrate::util\toutside\t1\n", "expect": {"violations": []}},
    {"name": "no places is an error", "rule": {"name": "r", "subjects": {"all": true}, "must_be_in": {"places": []}}, "expect": {"errors": [{"code": "empty-list", "role": "place"}]}},
    {"name": "a place that matches no unit is an error", "rule": {"name": "r", "subjects": {"all": true}, "must_be_in": {"places": ["crate::api::**", "crate::nothing"]}}, "expect": {"errors": [{"code": "pattern-matches-nothing", "role": "place", "value": "crate::nothing"}]}},
    {"name": "an invalid place is an error", "rule": {"name": "r", "subjects": {"all": true}, "must_be_in": {"places": [["a**"]]}}, "expect": {"errors": [{"code": "invalid-pattern", "role": "place", "value": "a**"}]}}
  ]
}
