{
  "description": "`items`: rules about the declarations of the units, selected by name, kind, visibility and relation.",
  "separator": "::",
  "facts": {
    "units": ["crate", "crate::api", "crate::domain", "crate::internal", "crate::storage"],
    "items": ["crate::domain::Repository", "crate::storage::PgRepository", "crate::api::MemRepository", "crate::storage::Cache", "crate::internal::Helper", "crate::internal::helper", "crate::api::Dto", "crate::internal::test_helper", "crate::api::Dto::id"],
    "kinds": ["use"],
    "tags": ["test"],
    "item_kinds": ["struct", "enum", "trait", "fn", "field"],
    "member_kinds": ["field"],
    "visibilities": ["pub", "pub(crate)", "private"],
    "relations": ["implements", "derives"],
    "facts": [
      {"unit": "crate::api", "file": "src/api.rs", "line": 1, "reference": {"target": "crate::domain::Repository", "kind": "use"}}
    ],
    "declarations": [
      {"path": "crate::domain::Repository", "name": "Repository", "unit": "crate::domain", "file": "src/domain.rs", "line": 1, "kind": "trait", "visibility": "pub"},
      {"path": "crate::storage::PgRepository", "name": "PgRepository", "unit": "crate::storage", "file": "src/storage.rs", "line": 2, "kind": "struct", "visibility": "pub", "relations": [{"relation": "implements", "target": "crate::domain::Repository"}, {"relation": "derives", "target": "std::fmt::Debug"}]},
      {"path": "crate::api::MemRepository", "name": "MemRepository", "unit": "crate::api", "file": "src/api.rs", "line": 3, "kind": "struct", "visibility": "pub", "relations": [{"relation": "implements", "target": "crate::domain::Repository"}]},
      {"path": "crate::storage::Cache", "name": "Cache", "unit": "crate::storage", "file": "src/storage.rs", "line": 5, "kind": "struct", "visibility": "pub(crate)", "relations": [{"relation": "implements", "target": "crate::domain::Repository"}]},
      {"path": "crate::internal::Helper", "name": "Helper", "unit": "crate::internal", "file": "src/internal.rs", "line": 1, "kind": "struct", "visibility": "pub", "relations": [{"relation": "derives", "target": "serde::Serialize"}]},
      {"path": "crate::internal::helper", "name": "helper", "unit": "crate::internal", "file": "src/internal.rs", "line": 4, "kind": "fn", "visibility": "private"},
      {"path": "crate::api::Dto", "name": "Dto", "unit": "crate::api", "file": "src/api.rs", "line": 6, "kind": "struct", "visibility": "pub", "relations": [{"relation": "derives", "target": "serde::Serialize"}, {"relation": "derives", "target": "std::fmt::Debug"}]},
      {"path": "crate::internal::test_helper", "name": "test_helper", "unit": "crate::internal", "file": "src/internal.rs", "line": 9, "kind": "fn", "visibility": "pub", "tags": ["test"]},
      {"path": "crate::api::Dto::id", "name": "id", "unit": "crate::api", "file": "src/api.rs", "line": 7, "kind": "field", "visibility": "pub"}
    ]
  },
  "cases": [
    {"name": "the items that implement a trait must reside in some units", "rule": {"name": "r", "subjects": {"all": true}, "items": {"related": [{"relation": "implements", "any_of": ["crate::domain::Repository"]}], "must": {"reside_in": ["crate::storage::**"]}}}, "expect": {"violations": [{"unit": "crate::api", "file": "src/api.rs", "line": 3, "column": 1, "detail": "item", "item": "crate::api::MemRepository", "item_kind": "struct"}]}},
    {"name": "the items that implement a trait must have names of a form", "rule": {"name": "r", "subjects": {"all": true}, "items": {"related": [{"relation": "implements", "any_of": ["crate::domain::Repository"]}], "must": {"be_named": ["*Repository"]}}}, "expect": {"violations": [{"item": "crate::storage::Cache", "unit": "crate::storage"}]}},
    {"name": "a related pattern matches within the target", "rule": {"name": "r", "subjects": {"all": true}, "items": {"related": [{"relation": "implements", "any_of": ["crate::domain"]}], "must": {"be_named": ["*Repository"]}}}, "expect": {"violations": [{"item": "crate::storage::Cache"}]}},
    {"name": "no item of a unit may have a visibility", "rule": {"name": "r", "subjects": {"any_of": ["crate::internal"]}, "items": {"visibilities": ["pub"], "must": "not_exist"}}, "expect": {"violations": [{"item": "crate::internal::Helper"}, {"item": "crate::internal::test_helper", "line": 9}]}},
    {"name": "ignored tags apply to declarations", "rule": {"name": "r", "subjects": {"any_of": ["crate::internal"]}, "items": {"visibilities": ["pub"], "must": "not_exist"}, "ignore_tags": ["test"]}, "expect": {"violations": [{"item": "crate::internal::Helper"}]}},
    {"name": "an item may derive a trait only in some units", "rule": {"name": "r", "subjects": {"all": true, "except": ["crate::api"]}, "items": {"related": [{"relation": "derives", "any_of": ["serde::Serialize"]}], "must": "not_exist"}}, "expect": {"violations": [{"item": "crate::internal::Helper", "unit": "crate::internal"}]}},
    {"name": "the items of a kind must have a relation", "rule": {"name": "r", "subjects": {"all": true}, "items": {"kinds": ["struct"], "must": {"have": {"relation": "derives", "any_of": ["std::fmt::Debug"]}}}}, "expect": {"violations": [{"item": "crate::api::MemRepository"}, {"item": "crate::storage::Cache"}, {"item": "crate::internal::Helper"}]}},
    {"name": "several kinds and several visibilities form unions", "rule": {"name": "r", "subjects": {"all": true}, "items": {"kinds": ["struct", "fn"], "visibilities": ["private", "pub(crate)"], "must": "not_exist"}}, "expect": {"violations": [{"item": "crate::storage::Cache"}, {"item": "crate::internal::helper", "item_kind": "fn"}]}},
    {"name": "names select items", "rule": {"name": "r", "subjects": {"all": true}, "items": {"named": ["*Repository", "Dto"], "kinds": ["struct"], "must": {"reside_in": ["crate::storage"]}}}, "expect": {"violations": [{"item": "crate::api::MemRepository"}, {"item": "crate::api::Dto"}]}},
    {"name": "several related entries must all hold", "rule": {"name": "r", "subjects": {"all": true}, "items": {"related": [{"relation": "implements", "any_of": ["crate::domain::Repository"]}, {"relation": "derives", "any_of": ["std::fmt::Debug"]}], "must": {"reside_in": ["crate::api"]}}}, "expect": {"violations": [{"item": "crate::storage::PgRepository"}]}},
    {"name": "a relation counts only with its own kind", "rule": {"name": "r", "subjects": {"all": true}, "items": {"related": [{"relation": "implements", "any_of": ["crate::domain::Repository"]}], "must": {"have": {"relation": "derives", "any_of": ["crate::domain::Repository"]}}}}, "expect": {"violations": [{"item": "crate::storage::PgRepository"}, {"item": "crate::api::MemRepository"}, {"item": "crate::storage::Cache"}]}},
    {"name": "a member is not selected when no kind is named", "rule": {"name": "r", "subjects": {"any_of": ["crate::api"]}, "items": {"visibilities": ["pub"], "must": "not_exist"}}, "expect": {"violations": [{"item": "crate::api::MemRepository"}, {"item": "crate::api::Dto"}]}},
    {"name": "a member is selected when its kind is named", "rule": {"name": "r", "subjects": {"any_of": ["crate::api"]}, "items": {"kinds": ["struct", "field"], "visibilities": ["pub"], "must": "not_exist"}}, "expect": {"violations": [{"item": "crate::api::MemRepository"}, {"item": "crate::api::Dto"}, {"item": "crate::api::Dto::id", "item_kind": "field", "line": 7}]}},
    {"name": "a selection without items passes", "rule": {"name": "r", "subjects": {"all": true}, "items": {"named": ["Pg*"], "must": {"reside_in": ["crate::storage"]}}}, "expect": {"violations": []}},
    {"name": "a baseline accepts an item", "rule": {"name": "r", "subjects": {"all": true}, "items": {"related": [{"relation": "implements", "any_of": ["crate::domain::Repository"]}], "must": {"reside_in": ["crate::storage::**"]}}}, "expect": {"violations": []}, "baseline": "r\tcrate::api\titem crate::api::MemRepository\t1\n"},
    {"name": "names that are empty, invalid or match nothing are errors", "rule": {"name": "r", "subjects": {"all": true}, "items": {"named": [], "must": "not_exist"}}, "expect": {"errors": [{"code": "empty-list", "role": "name"}]}},
    {"name": "a name that matches nothing is an error", "rule": {"name": "r", "subjects": {"all": true}, "items": {"named": ["Repo*", "Nope*", ["**"], ["a**"]], "must": "not_exist"}}, "expect": {"errors": [{"code": "pattern-matches-nothing", "role": "name", "value": "Nope*"}, {"code": "invalid-pattern", "role": "name", "value": "**"}, {"code": "invalid-pattern", "role": "name", "value": "a**"}]}},
    {"name": "item kinds and visibilities must be known", "rule": {"name": "r", "subjects": {"all": true}, "items": {"kinds": ["class"], "visibilities": ["exported"], "must": "not_exist"}}, "expect": {"errors": [{"code": "unknown-item-kind", "role": "item-kind", "value": "class"}, {"code": "unknown-visibility", "role": "visibility", "value": "exported"}]}},
    {"name": "empty lists of kinds and visibilities are errors", "rule": {"name": "r", "subjects": {"all": true}, "items": {"kinds": [], "visibilities": [], "must": "not_exist"}}, "expect": {"errors": [{"code": "empty-list", "role": "item-kind"}, {"code": "empty-list", "role": "visibility"}]}},
    {"name": "a related filter must be known and match", "rule": {"name": "r", "subjects": {"all": true}, "items": {"related": [{"relation": "extends", "any_of": ["crate::domain::Nothing", ["a**"]]}], "must": "not_exist"}}, "expect": {"errors": [{"code": "unknown-relation", "role": "relation", "value": "extends"}, {"code": "pattern-matches-nothing", "role": "related", "value": "crate::domain::Nothing"}, {"code": "invalid-pattern", "role": "related", "value": "a**"}]}},
    {"name": "an empty related list is an error", "rule": {"name": "r", "subjects": {"all": true}, "items": {"related": [{"relation": "derives", "any_of": []}], "must": "not_exist"}}, "expect": {"errors": [{"code": "empty-list", "role": "related"}]}},
    {"name": "places must match units", "rule": {"name": "r", "subjects": {"all": true}, "items": {"must": {"reside_in": ["crate::nothing"]}}}, "expect": {"errors": [{"code": "pattern-matches-nothing", "role": "place", "value": "crate::nothing"}]}},
    {"name": "required names must be valid", "rule": {"name": "r", "subjects": {"all": true}, "items": {"must": {"be_named": ["Good*", ["**"]]}}}, "expect": {"errors": [{"code": "invalid-pattern", "role": "required-name", "value": "**"}]}},
    {"name": "required names need not exist", "rule": {"name": "r", "subjects": {"all": true}, "items": {"kinds": ["trait"], "must": {"be_named": ["*Port"]}}}, "expect": {"violations": [{"item": "crate::domain::Repository"}]}},
    {"name": "a required relation must be known, and internal targets must exist", "rule": {"name": "r", "subjects": {"all": true}, "items": {"must": {"have": {"relation": "extends", "any_of": ["crate::domain::Nothing", "std::fmt::Display"]}}}}, "expect": {"errors": [{"code": "unknown-relation", "role": "relation", "value": "extends"}, {"code": "pattern-matches-nothing", "role": "required", "value": "crate::domain::Nothing"}]}},
    {"name": "an empty required list is an error", "rule": {"name": "r", "subjects": {"all": true}, "items": {"must": {"have": {"relation": "derives", "any_of": []}}}}, "expect": {"errors": [{"code": "empty-list", "role": "required"}]}},
    {"name": "an exemption has no use in a rule about items", "rule": {"name": "r", "subjects": {"all": true}, "items": {"must": "not_exist"}, "exemptions": [{"from": {"any_of": ["crate::api"]}, "to": ["crate::domain"]}]}, "expect": {"errors": [{"code": "unused-exemption", "role": "exemption", "value": "crate::api -> crate::domain"}]}},
    {"name": "a demand about uses cannot fail when no fact is inside an item", "rule": {"name": "r", "subjects": {"all": true}, "items": {"must": {"not_use": {"any_of": ["crate::domain"]}}}}, "expect": {"errors": [{"code": "no-subjects"}]}}
  ]
}
