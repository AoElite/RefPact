 },
 "cases": [
  {
   "name": "a unit with more lines than the limit is reported",
   "rule": {
    "name": "r",
    "subjects": {
     "all": true
    },
    "must_not_exceed_lines": {
     "lines": 100
    }
   },
   "expect": {
    "violations": [
     {
      "unit": "crate::api",
      "file": "src/api.rs",
      "line": 0,
      "column": 0,
      "detail": "too-long",
      "lines": 120,
      "limit": 100
     }
    ]
   }
  },
  {
   "name": "a unit with as many lines as the limit is not reported",
   "rule": {
    "name": "r",
    "subjects": {
     "all": true
    },
    "must_not_exceed_lines": {
     "lines": 120
    }
   },
   "expect": {
    "violations": []
   }
  },
  {
   "name": "each unit that is too long is reported, in the order of the units, and a unit without facts has the file of a declaration",
   "rule": {
    "name": "r",
    "subjects": {
     "all": true
    },
    "must_not_exceed_lines": {
     "lines": 9
    }
   },
   "expect": {
    "violations": [
     {
      "unit": "crate",
      "lines": 10,
      "file": ""
     },
     {
      "unit": "crate::api",
      "lines": 120,
      "file": "src/api.rs"
     },
     {
      "unit": "crate::domain",
      "lines": 40,
      "file": "src/domain.rs"
     }
    ]
   }
  },
  {
   "name": "only the selected units are checked",
   "rule": {
    "name": "r",
    "subjects": {
     "any_of": [
      "crate::domain"
     ]
    },
    "must_not_exceed_lines": {
     "lines": 9
    }
   },
   "expect": {
    "violations": [
     {
      "unit": "crate::domain",
      "detail": "too-long",
      "lines": 40,
      "limit": 9
     }
    ]
   }
  },
  {
   "name": "a unit whose lines are not counted is not reported",
   "rule": {
    "name": "r",
    "subjects": {
     "any_of": [
      "crate::domain",
      "crate::util"
     ]
    },
    "must_not_exceed_lines": {
     "lines": 0
    }
   },
   "expect": {
    "violations": [
     {
      "unit": "crate::domain"
     }
    ]
   }
  },
  {
   "name": "without a selected unit whose lines are counted, the rule cannot fail",
   "rule": {
    "name": "r",
    "subjects": {
     "any_of": [
      "crate::util"
     ]
    },
    "must_not_exceed_lines": {
     "lines": 0
    }
   },
   "expect": {
    "errors": [
     {
      "code": "no-subjects"
     }
    ]
   }
  },
  {
   "name": "an item with more lines than the limit is reported at its name",
   "rule": {
    "name": "r",
    "subjects": {
     "all": true
    },
    "items": {
     "must": {
      "not_exceed_lines": 50
     }
    }
   },
   "expect": {
    "violations": [
     {
      "unit": "crate::api",
      "file": "src/api.rs",
      "line": 10,
      "column": 1,
      "detail": "too-long",
      "item": "crate::api::serve",
      "item_kind": "fn",
      "lines": 61,
      "limit": 50
     }
    ]
   }
  },
  {
   "name": "the lines of an item are counted from the line of its name to its end line",
   "rule": {
    "name": "r",
    "subjects": {
     "all": true
    },
    "items": {
     "must": {
      "not_exceed_lines": 5
     }
    }
   },
   "expect": {
    "violations": [
     {
      "item": "crate::api::serve",
      "lines": 61
     },
     {
      "item": "crate::api::long_test",
      "lines": 30
     },
     {
      "item": "crate::domain::Order",
      "lines": 20
     }
    ]
   }
  },
  {
   "name": "an item with as many lines as the limit is not reported",
   "rule": {
    "name": "r",
    "subjects": {
     "all": true
    },
    "items": {
     "must": {
      "not_exceed_lines": 61
     }
    }
   },
   "expect": {
    "violations": []
   }
  },
  {
   "name": "an item on one line has one line",
   "rule": {
    "name": "r",
    "subjects": {
     "any_of": [
      "crate::domain"
     ]
    },
    "items": {
     "must": {
      "not_exceed_lines": 0
     },
     "kinds": [
      "fn"
     ]
    }
   },
   "expect": {
    "violations": [
     {
      "item": "crate::domain::total",
      "lines": 1,
      "limit": 0
     }
    ]
   }
  },
  {
   "name": "the filters of a rule about items select the items that are measured",
   "rule": {
    "name": "r",
    "subjects": {
     "all": true
    },
    "items": {
     "must": {
      "not_exceed_lines": 10
     },
     "kinds": [
      "fn"
     ]
    },
    "ignore_tags": [
     "test"
    ]
   },
   "expect": {
    "violations": [
     {
      "item": "crate::api::serve"
     }
    ]
   }
  },
  {
   "name": "an item without an end line is not reported",
   "rule": {
    "name": "r",
    "subjects": {
     "any_of": [
      "crate::util"
     ]
    },
    "items": {
     "must": {
      "not_exceed_lines": 0
     }
    }
   },
   "expect": {
    "violations": []
   }
  },
  {
   "name": "a baseline counts a long unit and a long item by their names, not by their lines",
   "rule": {
    "name": "r",
    "subjects": {
     "all": true
    },
    "items": {
     "must": {
      "not_exceed_lines": 50
     }
    }
   },
   "baseline": "r\tcrate::api\tlong item crate::api::serve\t1\n",
   "expect": {
    "violations": [],
    "stale": []
   }
  }
 ]
}
