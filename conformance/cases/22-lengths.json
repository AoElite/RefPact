    "visibility": "pub",
    "end_line": 84
   },
   {
    "path": "crate::api::long_test",
    "name": "long_test",
    "unit": "crate::api",
    "file": "src/api.rs",
    "line": 90,
    "kind": "fn",
    "visibility": "pub",
    "end_line": 119,
    "tags": [
     "test"
    ]
   },
   {
    "path": "crate::domain::Order",
    "name": "Order",
    "unit": "crate::domain",
    "file": "src/domain.rs",
    "line": 3,
    "kind": "struct",
    "visibility": "pub",
    "end_line": 22
   },
   {
    "path": "crate::domain::total",
    "name": "total",
    "unit": "crate::domain",
    "file": "src/domain.rs",
    "line": 30,
    "kind": "fn",
    "visibility": "pub",
